{
  "name": "app2-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint apps packages",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "web": "npm run web -w @app2/public",
    "android": "npm run android -w @app2/public",
    "ios": "npm run ios -w @app2/public",
    "export:web": "EXPO_NO_TELEMETRY=1 npm run export -w @app2/public",
    "check:edge": "deno check supabase/functions/*/index.ts",
    "test:db": "bash scripts/test-database.sh",
    "test:e2e": "npm exec -w @app2/public -- playwright test",
    "format": "prettier --write apps packages supabase/functions *.md",
    "test:edge": "deno test supabase/functions/_shared/signature_test.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~55.0.0",
    "deno": "^2.9.6",
    "eslint": "^9.0.0",
    "expo": "~55.0.0",
    "expo-secure-store": "~55.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.0",
    "prettier": "^3.9.10",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.0.0"
  }
}
