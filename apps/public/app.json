{
  "expo": {
    "name": "APP_NAME_2",
    "slug": "app-name-2",
    "scheme": "app2",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow APP_NAME_2 to select media for your posts."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow APP_NAME_2 to record voice posts."
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "ios": {
      "bundleIdentifier": "com.example.app2"
    },
    "android": {
      "package": "com.example.app2"
    }
  }
}
